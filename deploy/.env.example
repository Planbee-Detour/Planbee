# make -f deploy/Makefile env로 생성 후 실제 값은 사람이 입력한다.
# Compose 2.30+의 raw 형식. 값을 따옴표로 감싸지 않는다. $·#은 값 그대로 유지된다.
# 이 파일은 Makefile/shell로 실행하지 않는다. 시크릿을 git에 올리지 않는다.
# Session pooler 호스트·사용자명은 Supabase Connect 화면의 값을 그대로 사용한다.
# JDBC URL 예시 (비밀번호는 URL에 넣지 않음):
# jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase.crt
# Supabase 루트 인증서는 deploy/certs/supabase.crt에 사람이 저장한다.
PRD_DB_URL=
PRD_DB_USERNAME=
PRD_DB_PASSWORD=
TOUR_API_KEY=
JWT_SECRET=
SUPPORT_CONTACT_EMAIL=
DISCORD_WEBHOOK_URL=

# 비밀이 아닌 초기 운영 설정. 실측 후 조정한다.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+ExitOnOutOfMemoryError
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=1
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=10000
SERVER_TOMCAT_THREADS_MAX=20
SERVER_TOMCAT_THREADS_MINSPARE=2
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRINGDOC_APIDOCS_ENABLED=false
SPRINGDOC_SWAGGERUI_ENABLED=false
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
TZ=UTC
