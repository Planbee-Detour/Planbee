# ─────────────────────────────────────────────────────────────────────
# Planbee 환경 변수 (서버 + Docker)
#
# 이 파일(.env.example)은 git 에 커밋된다. **실제 값은 .env 에 두고 .env 는 커밋하지 않는다.**
#
#   make env    → .env.example 을 복사해 .env 를 만든다 (기존 .env 는 덮어쓰지 않음)
#
# 여기 적힌 값은 "로컬에서 그대로 동작하는" 값이다.
# 운영/스테이징 값은 절대 이 파일에 적지 않는다. 그 값들은 배포 환경의 시크릿 저장소에서 주입한다.
#
# 작성 규칙
#   - 따옴표를 쓰지 않는다 (Makefile 이 이 파일을 그대로 읽는다)
#   - 값 안에 # 을 넣지 않는다 (주석으로 해석된다)
# ─────────────────────────────────────────────────────────────────────

# ── 데이터베이스 ─────────────────────────────────────────────────────
# 로컬은 `make db-up` 으로 띄운 컨테이너를 가리킨다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── 장소 데이터 (SECRET) ────────────────────────────────────────────
# 한국관광공사 TourAPI(KorService2) 서비스 키.
# 발급: data.go.kr → "한국관광공사_국문 관광정보 서비스_GW" 활용신청 → 마이페이지의
#       **일반 인증키(Decoding)** 를 넣는다. 인코딩 키를 넣으면 이중 인코딩된다
#       (server/.../place/tour/TourApiProperties 참조).
# 없으면 서버가 기동 시점에 멈춘다 (RequiredEnvironmentCheck).
TOUR_API_KEY=

# ── 인증 (SECRET) ────────────────────────────────────────────────────
# JWT HS256 서명 키. 최소 32바이트.
# 운영에서는 반드시 새로 생성해 주입한다:  openssl rand -base64 48
# 이 키가 유출되면 임의의 토큰을 위조할 수 있다.
JWT_SECRET=

# ── 호스트 포트 ──────────────────────────────────────────────────────
# 이미 사용 중인 포트가 있으면 여기서 바꾼다.
API_PORT=
DB_PORT=

# ── 문의 창구 ───────────────────────────────────────────────────────
# 거절·정지·검토 중 안내 화면과 로그인 잠금 배너에 표시하는 문의 주소.
# 서버가 응답에 담아 내려주고 앱은 하드코딩하지 않는다 (C-8 / auth AC-42).
# 개인 계정이 아니라 문의 전용 주소를 쓴다 — 잠금 응답은 인증되지 않은 사용자에게도 간다.
# 비워 두면 화면은 "문의 창구를 준비하고 있어요" 대체 안내로 정상 동작한다 (AC-43·AC-44).
# docs/legal/privacy-policy.md 11항, terms.md 제8조 2항과 같은 값이어야 한다.
SUPPORT_CONTACT_EMAIL=

# ── 관리자 알림 (SECRET) ────────────────────────────────────────────
# 새 가입 신청이 접수되면 이 Discord 채널로 알린다 (admin-user-approval AC-26).
# 발급: Discord 채널 설정 → 연동 → 웹후크. **URL 자체가 시크릿이다** —
# 아는 사람은 누구나 그 채널에 글을 쓸 수 있으므로 이 파일·코드·커밋에 값을 적지 않는다 (C-4).
#
# 메시지에는 **대기 건수와 안내 문구만** 담는다. 이메일·가입 사유·사용자 식별자·비밀번호·
# 토큰을 넣지 않는다 (AC-31) — Discord 는 미국 사업자라 개인정보를 실으면
# 「개인정보 보호법」 제28조의8 의 국외 이전이 되어 가입 화면에 동의 항목이 하나 더 필요해진다.
# docs/legal/privacy-policy.md 5항이 이 판단을 반영하고 있다.
#
# **비워 두는 것이 정상 동작이다** (AC-29) — 값이 없으면 발송을 건너뛰고 서버는 정상 기동한다.
# RequiredEnvironmentCheck.REQUIRED 에 넣지 않는다 (server.md S-28 예외).
DISCORD_WEBHOOK_URL=
